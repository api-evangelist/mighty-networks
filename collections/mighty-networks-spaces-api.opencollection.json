            "name": "Create a new space in the network",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mn.co/admin/v1/networks/:network_id/spaces",
            "params": [
              {
                "name": "network_id",
                "value": "",
                "type": "path",
                "description": "The Network's unique integer ID, or subdomain"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
