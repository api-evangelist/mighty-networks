              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the space to fetch"
              },
              {
                "name": "network_id",
                "value": "",
                "type": "path",
                "description": "The Network's unique integer ID, or subdomain"
              }
            ]
          },
          "docs": "Query details of a specific space by its ID"
        },
