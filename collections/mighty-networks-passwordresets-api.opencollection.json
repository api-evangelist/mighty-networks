{
  "opencollection": "1.0.0",
  "info": {
    "name": "The Mighty Networks Admin AbuseReports PasswordResets API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "PasswordResets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send a password reset email to a member",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mn.co/admin/v1/networks/:network_id/members/:member_id/password_resets",
            "params": [
              {
                "name": "member_id",
                "value": "",
                "type": "path",
                "description": "ID of the member"
              },
              {
                "name": "network_id",
                "value": "",
                "type": "path",
                "description": "The Network's unique integer ID, or subdomain"
              }
            ]
          },
          "docs": "Send a password reset email to a member"
        }
      ]
    }
  ],
  "bundled": true
}