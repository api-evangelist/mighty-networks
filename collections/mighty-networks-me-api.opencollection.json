{
  "opencollection": "1.0.0",
  "info": {
    "name": "The Mighty Networks Admin AbuseReports Me API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Me",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Return information about the authenticated access token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mn.co/admin/v1/networks/:network_id/me",
            "params": [
              {
                "name": "network_id",
                "value": "",
                "type": "path",
                "description": "The Network's unique integer ID, or subdomain"
              }
            ]
          },
          "docs": "Return information about the authenticated access token"
        }
      ]
    }
  ],
  "bundled": true
}