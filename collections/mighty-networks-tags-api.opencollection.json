            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mn.co/admin/v1/networks/:network_id/members/:member_id/tags",
            "params": [
              {
                "name": "member_id",
                "value": "",
                "type": "path",
                "description": "ID of the member"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Items per page (max 100)"
              },
              {
                "name": "network_id",
                "value": "",
                "type": "path",
                "description": "The Network's unique integer ID, or subdomain"
              }
            ]
          },
          "docs": "Return tags for the given member"
        },
