            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "The ID of the course (space)"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the coursework item"
              },
              {
                "name": "network_id",
                "value": "",
                "type": "path",
                "description": "The Network's unique integer ID, or subdomain"
              }
            ]
          },
          "docs": "Returns a single coursework item by ID"
        },
