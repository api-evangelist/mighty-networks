        {
          "info": {
            "name": "Updates a poll or question",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.mn.co/admin/v1/networks/:network_id/polls/:id/",
            "params": [
              {
                "name": "id",
