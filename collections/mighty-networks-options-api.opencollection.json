{
  "opencollection": "1.0.0",
  "info": {
    "name": "The Mighty Networks Admin AbuseReports Options API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
